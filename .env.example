# Application
APP_ENV=dev
LOG_LEVEL=INFO
DATA_DIR=./data

# Security
API_KEY=change-me-dev-key

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# LLM Tier 2 (mid-tier model for scoring)
# Any OpenAI-compatible chat-completions model works (build_agent uses
# PromptedOutput mode so even thinking models like deepseek-v4 are fine).
LLM_TIER2_BASE_URL=https://api.deepseek.com/v1
LLM_TIER2_API_KEY=sk-PLACEHOLDER
LLM_TIER2_MODEL=deepseek-v4-flash

# LLM Tier 3 (top-tier model for deep analysis + Attribution agent)
# Same compatibility notes as Tier 2. Use a smarter model here if budget allows.
LLM_TIER3_BASE_URL=https://api.deepseek.com/v1
LLM_TIER3_API_KEY=sk-PLACEHOLDER
LLM_TIER3_MODEL=deepseek-v4-flash

# Concurrency / rate limits
YFINANCE_MAX_CONCURRENT=10
LLM_MAX_CONCURRENT=8
