# Application
APP_ENV=dev
LOG_LEVEL=INFO
DATA_DIR=./data

# Security
# API_KEY guards every API endpoint and the /app login. Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# Empty keys are always rejected; APP_ENV=prod refuses keys shorter than 32
# characters or starting with "change-me" (dev only logs a warning).
API_KEY=change-me-dev-key

# Browser session (/app UI)
# Optional dedicated session-signing secret (same generator as API_KEY). When
# empty, the signing key is derived from API_KEY. Changing it signs everyone out.
WEB_SESSION_SECRET=
# Set true whenever the UI is served over HTTPS (TLS-terminating reverse proxy).
WEB_COOKIE_SECURE=false
# Public origin accepted by the CSRF origin check when a reverse proxy rewrites
# the Host header, e.g. https://research.example.com (leave empty otherwise).
WEB_PUBLIC_ORIGIN=

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Runtime-settings encryption (Fernet). Encrypts the LLM / iFinD API keys stored
# in the database. Keep it out of DATA_DIR and back it up separately: without it
# stored secrets cannot be read. Generate one with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Runtime settings - FIRST IMPORT ONLY
#
# Everything below is managed in the Web UI (/app/settings) or with
# `ia settings`, and stored in the database (docs/product/settings-plan.md).
# On the first start of the api / worker / scheduler, values set here (and the
# schedules in config/app.yaml) are imported once; afterwards the database is
# the source of truth and changes here are ignored (a `settings.env_ignored`
# warning lists them). Secrets are imported only when SETTINGS_ENCRYPTION_KEY
# is set; otherwise they keep being read from here until saved in the UI.
# ---------------------------------------------------------------------------

# LLM Tier 3 (research explanation model)
# Any OpenAI-compatible chat-completions endpoint works.
#LLM_TIER3_BASE_URL=https://api.deepseek.com/v1
#LLM_TIER3_API_KEY=sk-PLACEHOLDER
#LLM_TIER3_MODEL=deepseek-v4-flash

# Per-request LLM timeout in seconds (timeouts are retried by the research worker)
#LLM_REQUEST_TIMEOUT_SECONDS=120

# Reasoning toggle for DeepSeek-style OpenAI-compatible endpoints (sent as
# `thinking: {type: ...}`): auto = do not send (default), enabled, disabled.
# Rule drafting is validated afterwards and its latency is mostly reasoning
# tokens (measured ~46 s vs ~10 s per draft); disabling it there is suggested.
#LLM_TIER3_THINKING=auto
#LLM_RULE_DRAFT_THINKING=auto

# A-share research via the standalone iFinD data gateway
#IFIND_PROXY_URL=http://127.0.0.1:7100
#IFIND_PROXY_API_KEY=replace-with-ifind-proxy-key

# Snapshot collection (worker): shared proxy budget, per-batch transient retries,
# completeness below which a run raises an action_required notification.
#IFIND_COLLECT_RATE_PER_MINUTE=40
#IFIND_COLLECT_BATCH_RETRIES=2
#SNAPSHOT_COMPLETENESS_THRESHOLD=0.95
# AkShare / Eastmoney financial collector: minimum seconds between calls (P1-A11).
#AKSHARE_MIN_INTERVAL_SECONDS=1.0

# Candidates (P1-D1): days an open candidate stays open; days a dismissed stock
# is not re-proposed by the weekly screen (manual nomination is not blocked).
#CANDIDATE_EXPIRY_DAYS=14
#CANDIDATE_DISMISS_COOLDOWN_DAYS=30

# iFinD verification budget (P1-A13): ifind-proxy calls allowed per rolling
# window (all sources counted in ifind_call_ledger); requests per ifind_verify run.
#IFIND_BUDGET_PER_5H=150
#IFIND_BUDGET_WINDOW_HOURS=5
#IFIND_VERIFY_MAX_REQUESTS=30
